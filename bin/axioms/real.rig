// real.rig — Real numbers for Grigor proofs
//
// The reals are introduced axiomatically (ordered complete field).
// No nat library is assumed; natural multiples are defined inductively here.
//
// Sections
//   1. Carrier and order
//   2. Field operations and axioms
//   3. Order axioms (including proper trichotomy)
//   4. Completeness (least-upper-bound principle)
//   5. Natural multiples (used for the Archimedean property)
//   6. Absolute value and distance
//   7. Useful consequences (stated as axioms pending proof infrastructure)

// ──────────────────────────────────────────────────────────────────────────
// 1. Carrier and order
// ──────────────────────────────────────────────────────────────────────────

Axiom R : Set.

// Strict less-than.
Axiom R_lt : R -> R -> Prop.

// Less-than-or-equal: branch on strict or equal.
Inductive R_le (x : R) (y : R) : Prop :=
  | R_le_lt : R_lt x y -> R_le x y
  | R_le_eq : eq R x y -> R_le x y.

// Trichotomy witness: exactly one of x < y, x = y, y < x.
Inductive R_trichotomy (x : R) (y : R) : Prop :=
  | R_lt_case : R_lt x y -> R_trichotomy x y
  | R_eq_case : eq R x y -> R_trichotomy x y
  | R_gt_case : R_lt y x -> R_trichotomy x y.

// ──────────────────────────────────────────────────────────────────────────
// 2. Field operations
// ──────────────────────────────────────────────────────────────────────────

Axiom R_zero : R.
Axiom R_one  : R.

Axiom R_add  : R -> R -> R.
Axiom R_mul  : R -> R -> R.
Axiom R_neg  : R -> R.
Axiom R_inv  : R -> R.          // defined for all R; only constrained for nonzero

Definition R_sub (x : R) (y : R) : R := R_add x (R_neg y).
Definition R_div (x : R) (y : R) : R := R_mul x (R_inv y).

// ── Additive abelian group ──
Axiom R_add_comm   : forall (x y : R), eq R (R_add x y) (R_add y x).
Axiom R_add_assoc  : forall (x y z : R),
                       eq R (R_add (R_add x y) z) (R_add x (R_add y z)).
Axiom R_add_zero_l : forall (x : R), eq R (R_add R_zero x) x.
Axiom R_add_neg    : forall (x : R), eq R (R_add x (R_neg x)) R_zero.

// ── Multiplicative abelian group on nonzero elements ──
Axiom R_mul_comm   : forall (x y : R), eq R (R_mul x y) (R_mul y x).
Axiom R_mul_assoc  : forall (x y z : R),
                       eq R (R_mul (R_mul x y) z) (R_mul x (R_mul y z)).
Axiom R_mul_one_l  : forall (x : R), eq R (R_mul R_one x) x.
Axiom R_mul_inv    : forall (x : R), R_lt R_zero x ->
                       eq R (R_mul x (R_inv x)) R_one.

// ── Distributivity (both sides) ──
Axiom R_distr_l    : forall (x y z : R),
                       eq R (R_mul x (R_add y z))
                            (R_add (R_mul x y) (R_mul x z)).
// Right distributivity follows from left + mul_comm, but is stated for
// direct use without appealing to commutativity every time.
Axiom R_distr_r    : forall (x y z : R),
                       eq R (R_mul (R_add x y) z)
                            (R_add (R_mul x z) (R_mul y z)).

Axiom R_zero_ne_one : eq R R_zero R_one -> False.

// ──────────────────────────────────────────────────────────────────────────
// 3. Order axioms
// ──────────────────────────────────────────────────────────────────────────

Axiom R_lt_irrefl  : forall (x : R), R_lt x x -> False.
Axiom R_lt_trans   : forall (x y z : R), R_lt x y -> R_lt y z -> R_lt x z.
// Asymmetry: x < y and y < x cannot both hold.
Axiom R_lt_asymm   : forall (x y : R), R_lt x y -> R_lt y x -> False.
// Totality: one of the three cases always holds.
Axiom R_trichot    : forall (x y : R), R_trichotomy x y.

// Compatibility with addition.
Axiom R_lt_add_compat : forall (x y z : R),
                          R_lt x y -> R_lt (R_add x z) (R_add y z).

// Compatibility with multiplication by a positive.
Axiom R_lt_mul_pos : forall (x y z : R),
                       R_lt R_zero z -> R_lt x y ->
                       R_lt (R_mul z x) (R_mul z y).

// ──────────────────────────────────────────────────────────────────────────
// 4. Completeness — least upper bound (LUB) principle
// ──────────────────────────────────────────────────────────────────────────

Definition is_upper_bound (P : R -> Prop) (b : R) : Prop :=
  forall (x : R), P x -> R_le x b.

// A predicate is bounded above if some upper bound exists.
// Encoded via CPS (double-negation shift) to stay in Prop without Sigma types.
Definition is_bounded_above (P : R -> Prop) : Prop :=
  forall (bot : Prop), (forall (b : R), is_upper_bound P b -> bot) -> bot.

// Every non-empty, bounded-above predicate has a least upper bound.
Axiom R_lub_exists : forall (P : R -> Prop),
                       // P is inhabited (encoded by CPS)
                       (forall (bot : Prop), (forall (x : R), P x -> bot) -> bot) ->
                       // P is bounded above
                       is_bounded_above P ->
                       // conclusion: a least upper bound exists
                       forall (bot : Prop),
                         (forall (s : R),
                            is_upper_bound P s ->
                            (forall (b : R), is_upper_bound P b -> R_le s b) ->
                            bot) ->
                         bot.

// ──────────────────────────────────────────────────────────────────────────
// 5. Natural multiples  (used for the Archimedean property)
// ──────────────────────────────────────────────────────────────────────────

// R_nat_mult x n means n is a non-negative integer multiple of x:
//   nm_zero : 0 is a multiple of any x
//   nm_succ : if n is a multiple of x, so is n + x
Inductive R_nat_mult (x : R) : R -> Prop :=
  | nm_zero : R_nat_mult x R_zero
  | nm_succ : forall n : R, R_nat_mult x n -> R_nat_mult x (R_add n x).

// Archimedean property: for every step eps > 0 and every target M, some
// natural multiple of eps exceeds M.
Axiom R_archimedean : forall (eps M : R),
                        R_lt R_zero eps ->
                        forall (bot : Prop),
                          (forall (n : R),
                             R_nat_mult eps n ->
                             R_lt M n ->
                             bot) ->
                          bot.

// ──────────────────────────────────────────────────────────────────────────
// 6. Absolute value and distance
// ──────────────────────────────────────────────────────────────────────────

Axiom R_abs : R -> R.

Axiom R_abs_nonneg  : forall (x : R), R_le R_zero (R_abs x).
Axiom R_abs_pos     : forall (x : R), R_lt R_zero x -> eq R (R_abs x) x.
Axiom R_abs_neg     : forall (x : R), R_lt x R_zero -> eq R (R_abs x) (R_neg x).
Axiom R_abs_zero    : eq R (R_abs R_zero) R_zero.
Axiom R_abs_triangle : forall (x y : R),
                         R_le (R_abs (R_add x y))
                              (R_add (R_abs x) (R_abs y)).

Definition R_dist (x : R) (y : R) : R := R_abs (R_sub x y).

// ──────────────────────────────────────────────────────────────────────────
// 7. Useful consequences (admissible axioms / convenience lemmas)
// ──────────────────────────────────────────────────────────────────────────
// These are provable from the axioms above but require a richer proof
// infrastructure.  They are stated as axioms so library users can appeal
// to them immediately.

Axiom R_add_zero_r : forall (x : R), eq R (R_add x R_zero) x.
Axiom R_mul_one_r  : forall (x : R), eq R (R_mul x R_one) x.
Axiom R_neg_zero   : eq R (R_neg R_zero) R_zero.
Axiom R_neg_neg    : forall (x : R), eq R (R_neg (R_neg x)) x.
Axiom R_mul_zero_l : forall (x : R), eq R (R_mul R_zero x) R_zero.
Axiom R_mul_zero_r : forall (x : R), eq R (R_mul x R_zero) R_zero.
Axiom R_neg_add    : forall (x y : R),
                       eq R (R_neg (R_add x y)) (R_add (R_neg x) (R_neg y)).
Axiom R_zero_lt_one : R_lt R_zero R_one.
