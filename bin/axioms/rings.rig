Module Type Ring := sig
  Axiom R    : Set.
  Axiom add  : R -> R -> R.
  Axiom zero : R.
  Axiom neg  : R -> R.
  Axiom mul  : R -> R -> R.
  Axiom one  : R.

  // Additive abelian group
  Axiom add_assoc  : forall x y z : R, add (add x y) z = add x (add y z).
  Axiom add_zero_l : forall x : R, add zero x = x.
  Axiom add_zero_r : forall x : R, add x zero = x.
  Axiom add_comm   : forall x y : R, add x y = add y x.
  Axiom add_neg_l  : forall x : R, add (neg x) x = zero.
  Axiom add_neg_r  : forall x : R, add x (neg x) = zero.

  // Multiplicative monoid
  Axiom mul_assoc  : forall x y z : R, mul (mul x y) z = mul x (mul y z).
  Axiom mul_one_l  : forall x : R, mul one x = x.
  Axiom mul_one_r  : forall x : R, mul x one = x.

  // Distributivity (both sides)
  Axiom mul_add_distr_l : forall x y z : R, mul x (add y z) = add (mul x y) (mul x z).
  Axiom mul_add_distr_r : forall x y z : R, mul (add x y) z = add (mul x z) (mul y z).

end.
