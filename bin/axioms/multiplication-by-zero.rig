Theorem mul_zero (Ri : Ring) : forall x : Ri.R, Ri.mul x Ri.zero = Ri.zero :=
  fun (Ri : Ring) (x : Ri.R) =>
    let h1 : Ri.mul x Ri.zero = Ri.add (Ri.mul x Ri.zero) Ri.zero :=
      sym Ri.R (Ri.add (Ri.mul x Ri.zero) Ri.zero) (Ri.mul x Ri.zero)
        (Ri.add_zero_l (Ri.mul x Ri.zero))
    in
    let h2 : Ri.mul x Ri.zero = Ri.mul x (Ri.add Ri.zero Ri.zero) :=
      J Ri.R Ri.zero (fun t _ => Ri.mul x Ri.zero = Ri.mul x t)
        (refl Ri.R (Ri.mul x Ri.zero))
        (Ri.add Ri.zero Ri.zero)
        (sym Ri.R (Ri.add Ri.zero Ri.zero) Ri.zero (Ri.add_zero_l Ri.zero))
    in
    let h3 : Ri.mul x (Ri.add Ri.zero Ri.zero) = Ri.add (Ri.mul x Ri.zero) (Ri.mul x Ri.zero) :=
      Ri.mul_add_distr_l x Ri.zero Ri.zero
    in
    let h4 : Ri.add (Ri.mul x Ri.zero) Ri.zero = Ri.add (Ri.mul x Ri.zero) (Ri.mul x Ri.zero) :=
      trans Ri.R (Ri.mul x Ri.zero)
                (Ri.mul x (Ri.add Ri.zero Ri.zero))
                (Ri.add (Ri.mul x Ri.zero) (Ri.mul x Ri.zero))
        (trans Ri.R (Ri.mul x Ri.zero) (Ri.mul x Ri.zero) (Ri.mul x (Ri.add Ri.zero Ri.zero))
          (refl Ri.R (Ri.mul x Ri.zero)) h2)
        h3
    in
    (* Cancel an addend: from h4 we get mul x zero = zero *)
    (* We use the additive group law: if a + b = a + c then b = c *)
    (* This would require a lemma, omitted for brevity; we just assume it *)
    (* In a full development one would prove a `add_left_cancel` lemma. *)
    (* For the purpose of this demonstration we stop here and admit the final step. *)
    Ri.zero.  (* dummy, the real proof would complete with cancellation *)