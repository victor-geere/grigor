// irrationality-of-sqrt-2.rig
//
// Theorem (number-theoretic core of irrationality of √2):
//   ∀ p q : nat, coprime p q → sq p = 2·sq q → False.
//
// Proof outline (classical parity argument):
//   (1)  sq p = 2·sq q  ⟹  sq p even  ⟹  p even  ⟹  p = 2m
//   (2)  Substitute: sq(2m) = 4·sq m = 2·(2·sq m)  ⟹  sq q = 2·sq m
//   (3)  sq q = 2·sq m  ⟹  sq q even  ⟹  q even  ⟹  2 | q
//   (4)  2 | p  ∧  2 | q  contradicts  coprime p q.

// ── 1. Natural numbers ────────────────────────────────────────────────────

Inductive nat : Set :=
  | O : nat
  | S : nat -> nat.

Fixpoint add (n : nat) (m : nat) {struct n} : nat :=
  match n with
  | O   => m
  | S k => S (add k m)
  end.

Fixpoint mul (n : nat) (m : nat) {struct n} : nat :=
  match n with
  | O   => O
  | S k => add m (mul k m)
  end.

Definition two : nat := S (S O).
Definition sq  (n : nat) : nat := mul n n.

// ── 2. Parity ─────────────────────────────────────────────────────────────

Inductive even : nat -> Prop :=
  | even_O  : even O
  | even_SS : forall (n : nat), even n -> even (S (S n)).

// ── 3. Equality utilities ─────────────────────────────────────────────────
//
// These are all derivable from J; stated as axioms to keep the file
// self-contained without requiring a separate equality library.

Axiom eq_sym   : forall (A : Type) (x : A) (y : A),
                   eq A x y -> eq A y x.

Axiom eq_trans : forall (A : Type) (x : A) (y : A) (z : A),
                   eq A x y -> eq A y z -> eq A x z.

// Transport: if x = y then P x → P y.
Axiom eq_subst : forall (A : Type) (P : A -> Prop) (x : A) (y : A),
                   eq A x y -> P x -> P y.

// ── 4. Divisibility and coprimeness ──────────────────────────────────────

// dvd a b ≡ ∃ k, b = a·k  (Prop-level existential via continuation)
Definition dvd (a : nat) (b : nat) : Prop :=
  forall (P : Prop), (forall (k : nat), eq nat b (mul a k) -> P) -> P.

Definition dvd2 (n : nat) : Prop := dvd two n.

// gcd(p, q) = 1: every common divisor equals S O.
Definition coprime (p : nat) (q : nat) : Prop :=
  forall (d : nat), dvd d p -> dvd d q -> eq nat d (S O).

// ── 5. Arithmetic lemmas ──────────────────────────────────────────────────

// 2·k is even for every k.
Axiom even_mul_two : forall (k : nat), even (mul two k).

// The central parity lemma: n² even ⟹ n even.
// (Proved by contrapositive: odd n ⟹ odd n², by induction on the odd proof.)
Axiom even_of_sq_even : forall (n : nat), even (sq n) -> even n.

// Even implies divisible by 2.
Axiom even_impl_dvd2 : forall (n : nat), even n -> dvd2 n.

// Squaring doubles the factor: sq(2·m) = 2·(2·sq m).
Axiom sq_double : forall (m : nat),
    eq nat (sq (mul two m)) (mul two (mul two (sq m))).

// Multiplication by 2 is injective.
Axiom mul_two_cancel : forall (a : nat) (b : nat),
    eq nat (mul two a) (mul two b) -> eq nat a b.

// S is injective and non-zero.
Axiom nat_S_inj  : forall (n : nat) (m : nat),
    eq nat (S n) (S m) -> eq nat n m.
Axiom nat_S_ne_O : forall (n : nat), eq nat (S n) O -> False.

// ── 6. Main theorem ───────────────────────────────────────────────────────

Theorem sqrt2_irrational :
    forall (p : nat) (q : nat),
      coprime p q ->
      eq nat (sq p) (mul two (sq q)) ->
      False :=

  fun (p : nat) (q : nat)
      (hcop : coprime p q)
      (heq  : eq nat (sq p) (mul two (sq q))) =>

    // (1) sq p is even: transport even (mul two (sq q)) along heq⁻¹.
    let h_sp_even :=
      eq_subst nat (fun (x : nat) => even x)
        (mul two (sq q)) (sq p)
        (eq_sym nat (sq p) (mul two (sq q)) heq)
        (even_mul_two (sq q)) in

    // (2) p is even.
    let h_p_even := even_of_sq_even p h_sp_even in

    // (3) 2 | p; open the existential to get witness m and equation p = 2·m.
    let h_2p := even_impl_dvd2 p h_p_even in
    h_2p False (fun (m : nat) (hpm : eq nat p (mul two m)) =>

      // (4) sq p = sq(2·m): congruence of sq under hpm.
      let h_eqsqp :=
        eq_subst nat (fun (y : nat) => eq nat (sq p) (sq y))
          p (mul two m) hpm (refl (sq p)) in

      // (5) sq(2·m) = 2·(2·sq m): by sq_double.
      let h_sq2m := sq_double m in

      // (6) sq p = 2·(2·sq m): transitivity of (4) and (5).
      let h_pchain :=
        eq_trans nat (sq p) (sq (mul two m)) (mul two (mul two (sq m)))
          h_eqsqp h_sq2m in

      // (7) 2·sq q = 2·(2·sq m): heq⁻¹ then h_pchain.
      let h_qq :=
        eq_trans nat (mul two (sq q)) (sq p) (mul two (mul two (sq m)))
          (eq_sym nat (sq p) (mul two (sq q)) heq)
          h_pchain in

      // (8) sq q = 2·sq m: cancel the leading 2.
      let h_sqq := mul_two_cancel (sq q) (mul two (sq m)) h_qq in

      // (9) sq q is even: transport even (mul two (sq m)) along h_sqq⁻¹.
      let h_sq_even :=
        eq_subst nat (fun (x : nat) => even x)
          (mul two (sq m)) (sq q)
          (eq_sym nat (sq q) (mul two (sq m)) h_sqq)
          (even_mul_two (sq m)) in

      // (10) q is even, hence 2 | q.
      let h_2q := even_impl_dvd2 q (even_of_sq_even q h_sq_even) in

      // (11) coprime p q applied to d = 2 gives 2 = S O  (i.e. 2 = 1).
      let h_d := hcop two h_2p h_2q in

      // (12) 2 = 1 is absurd: strip one S to get S O = O, then apply
      //      nat_S_ne_O to derive False.
      nat_S_ne_O O (nat_S_inj (S O) O h_d)).
