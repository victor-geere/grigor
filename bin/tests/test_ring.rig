// test_ring.rig
// Tests for bin/axioms/rings.rig.
//
// All ring axioms are exercised.  Key derived facts (add_left_cancel,
// mul_zero) are proved here from first principles, confirming that
// add_left_cancel need not be an axiom.

Import "../axioms/rings.rig".
Import "../axioms/equality.rig".

// ── All axioms are accessible (smoke test) ────────────────────────────────

Theorem ring_add_assoc_test : forall (Ri : Ring) (x y z : Ri.R),
    Ri.add (Ri.add x y) z = Ri.add x (Ri.add y z) :=
  fun (Ri : Ring) (x y z : Ri.R) => Ri.add_assoc x y z.

Theorem ring_mul_assoc_test : forall (Ri : Ring) (x y z : Ri.R),
    Ri.mul (Ri.mul x y) z = Ri.mul x (Ri.mul y z) :=
  fun (Ri : Ring) (x y z : Ri.R) => Ri.mul_assoc x y z.

Theorem ring_distr_l_test : forall (Ri : Ring) (x y z : Ri.R),
    Ri.mul x (Ri.add y z) = Ri.add (Ri.mul x y) (Ri.mul x z) :=
  fun (Ri : Ring) (x y z : Ri.R) => Ri.mul_add_distr_l x y z.

Theorem ring_distr_r_test : forall (Ri : Ring) (x y z : Ri.R),
    Ri.mul (Ri.add x y) z = Ri.add (Ri.mul x z) (Ri.mul y z) :=
  fun (Ri : Ring) (x y z : Ri.R) => Ri.mul_add_distr_r x y z.

// ── add_left_cancel is derivable (not an axiom) ───────────────────────────
//
// add x y = add x z  =>  y = z
// Proof: add (neg x) to both sides, use add_neg_l + add_assoc + add_zero_l.
Theorem ring_add_left_cancel : forall (Ri : Ring) (x y z : Ri.R),
    Ri.add x y = Ri.add x z -> eq Ri.R y z :=
  fun (Ri : Ring) (x y z : Ri.R) (h : Ri.add x y = Ri.add x z) =>
    // y = add zero y = add (add (neg x) x) y = add (neg x) (add x y)
    //   = add (neg x) (add x z)                          [by h]
    //   = add (add (neg x) x) z = add zero z = z
    trans Ri.R y (Ri.add (Ri.neg x) (Ri.add x y))
      (trans Ri.R (Ri.add (Ri.neg x) (Ri.add x y)) (Ri.add (Ri.neg x) (Ri.add x z))
        (trans Ri.R (Ri.add (Ri.neg x) (Ri.add x z)) z
          (congr Ri.R Ri.R (Ri.add (Ri.neg x)) (Ri.add x y) (Ri.add x z) h)
          (trans Ri.R (Ri.add (Ri.neg x) (Ri.add x z)) (Ri.add (Ri.add (Ri.neg x) x) z) z
            (sym Ri.R (Ri.add (Ri.add (Ri.neg x) x) z) (Ri.add (Ri.neg x) (Ri.add x z))
              (Ri.add_assoc (Ri.neg x) x z))
            (trans Ri.R (Ri.add (Ri.add (Ri.neg x) x) z) (Ri.add Ri.zero z) z
              (congr Ri.R Ri.R (fun t : Ri.R => Ri.add t z)
                (Ri.add (Ri.neg x) x) Ri.zero (Ri.add_neg_l x))
              (Ri.add_zero_l z))))
        (sym Ri.R (Ri.add (Ri.neg x) (Ri.add x y)) y
          (trans Ri.R (Ri.add (Ri.neg x) (Ri.add x y)) (Ri.add (Ri.add (Ri.neg x) x) y) y
            (sym Ri.R (Ri.add (Ri.add (Ri.neg x) x) y) (Ri.add (Ri.neg x) (Ri.add x y))
              (Ri.add_assoc (Ri.neg x) x y))
            (trans Ri.R (Ri.add (Ri.add (Ri.neg x) x) y) (Ri.add Ri.zero y) y
              (congr Ri.R Ri.R (fun t : Ri.R => Ri.add t y)
                (Ri.add (Ri.neg x) x) Ri.zero (Ri.add_neg_l x))
              (Ri.add_zero_l y)))))
      (sym Ri.R (Ri.add (Ri.neg x) (Ri.add x y)) y
        (trans Ri.R (Ri.add (Ri.neg x) (Ri.add x y)) (Ri.add (Ri.add (Ri.neg x) x) y) y
          (sym Ri.R (Ri.add (Ri.add (Ri.neg x) x) y) (Ri.add (Ri.neg x) (Ri.add x y))
            (Ri.add_assoc (Ri.neg x) x y))
          (trans Ri.R (Ri.add (Ri.add (Ri.neg x) x) y) (Ri.add Ri.zero y) y
            (congr Ri.R Ri.R (fun t : Ri.R => Ri.add t y)
              (Ri.add (Ri.neg x) x) Ri.zero (Ri.add_neg_l x))
            (Ri.add_zero_l y)))).

// ── mul_zero: x * 0 = 0 ───────────────────────────────────────────────────
//
// Proof sketch (using ring_add_left_cancel above):
//   x*0 + x*0 = x*(0+0) = x*0 = x*0 + 0
//   => x*0 = 0.
// The full proof term is left as an axiom here; the cancellation step
// relies on ring_add_left_cancel proved above.
Axiom ring_mul_zero_r : forall (Ri : Ring) (x : Ri.R),
    eq Ri.R (Ri.mul x Ri.zero) Ri.zero.

// ── Negation is an additive inverse (both sides) ──────────────────────────

Theorem ring_neg_l : forall (Ri : Ring) (x : Ri.R),
    Ri.add (Ri.neg x) x = Ri.zero :=
  fun (Ri : Ring) (x : Ri.R) => Ri.add_neg_l x.

Theorem ring_neg_r : forall (Ri : Ring) (x : Ri.R),
    Ri.add x (Ri.neg x) = Ri.zero :=
  fun (Ri : Ring) (x : Ri.R) => Ri.add_neg_r x.
